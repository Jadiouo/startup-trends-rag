# =============================================
# LLM — pick ONE of the blocks below (see llm.py for the model string format)
# =============================================

# --- A. Local Ollama (free, offline; `ollama pull llama3.1`) ---
LLM_MODEL=ollama/llama3.1
# OLLAMA_API_BASE=http://localhost:11434

# --- B. OpenAI ---
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- C. Google Gemini (AI Studio key) ---
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=...

# --- D. Any OpenAI-compatible server (vLLM, LM Studio, a LiteLLM proxy, ...) ---
# LLM_MODEL=openai/<model-name-on-the-server>
# LLM_API_BASE=https://your-server.example.com
# LLM_API_KEY=...

# =============================================
# Embedding (local sentence-transformers, no key needed)
# =============================================
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768

# =============================================
# pgvector (defaults match docker-compose.yml)
# =============================================
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_USER=raguser
PGVECTOR_PASSWORD=ragpassword
PGVECTOR_DB=ragdb

# =============================================
# RAG defaults
# =============================================
RAG_TOP_K=5
